# Copy to .env (local) or paste into Render → Environment. Every key is optional:
# anything left empty runs in clearly-labelled demo mode.
PORT=8080
SESSION_SECRET=change-me-to-a-long-random-string

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# Razorpay (test keys start with rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email sign-in codes via Resend
RESEND_API_KEY=
EMAIL_FROM=EcoSync <onboarding@resend.dev>

# OR Firebase Auth (Project settings → General → Web app config)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Optional
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
DATA_DIR=
