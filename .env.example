# Everything is optional. EcoSync runs with no keys at all.
PORT=8080

# Neon Postgres connection string (neon.tech → your project → Connect → copy the URL).
# Leave empty to use a local Postgres file in ./data (fine for development).
DATABASE_URL=

# Optional extras
# GEMINI_API_KEY=        # if set, the scanner and EcoBot use Gemini instead of the built-in models
# SESSION_SECRET=        # generated and stored in the database automatically if empty
